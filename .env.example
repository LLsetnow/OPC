# ── 环境变量模版 ──────────────────────────────────────────────────────
# 复制本文件为 .env 后填入实际值：
#   cp .env.example .env
# 然后编辑 .env 填入 API Key。

# ═══════════════════════════════════════════════════════════════════════
# API Key 回退链（优先级从高到低）：
#   Vision:  VISION_ > ZHIPU_ > LLM_
#   LLM:     LLM_ > ZHIPU_
#   ASR:     ASR_ > IMAGE_ > DASHSCOPE_
#   Image:   IMAGE_ > DASHSCOPE_
#   GPT-Img: GPT_IMAGE_ > IMAGE_
#   Qwen TTS: QWEN_TTS_ > IMAGE_
# ═══════════════════════════════════════════════════════════════════════


# ── LLM 模型配置 ─────────────────────────────────────────────────
# 用途：内容总结（bili）、AI日报（news）、提示词丰富（gpt-img/Z-image）、
#       LLM 断句修复（asr --llm-fix）、Vue 代码生成（ui2vue）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ── 智谱AI（TTS 引擎） ──────────────────────────────────────────────
# 用途：glm-tts 语音合成（tts --engine glm-tts）、音色克隆、音色列表
# 同时作为 Vision / LLM 的回退 API
ZHIPU_API_KEY=your_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── 阿里云 Qwen TTS（CosyVoice，默认 TTS 引擎） ─────────────────
# 用途：tts 默认引擎（tts --engine qwen-tts）
QWEN_TTS_API_KEY=your_dashscope_api_key_here
QWEN_TTS_MODEL=cosyvoice-v3-flash
# 复刻音色 ID（在阿里云百炼控制台创建）
# VOICE_ID1=cosyvoice-xxx
# VOICE_ID2=cosyvoice-yyy

# ── 视觉模型 API ──────────────────────────────────────────────────
# 用途：图片理解（read-img）、UI 截图分析（ui2vue）
# 未设置时回退到 ZHIPU_API_KEY / ZHIPU_BASE_URL
VISION_API_KEY=your_vision_api_key_here
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-5v-turbo

# ── 阿里云 DashScope ASR 语音识别 ───────────────────────────────
# 用途：语音转写（asr）、B站视频自动转写（bili）
# DashScope API Key 同时用于 ASR / TTS / 文生图
DASHSCOPE_API_KEY=your_dashscope_api_key_here
ASR_API_KEY=your_asr_api_key_here
ASR_MODEL=fun-asr-realtime

# ── 文生图（阿里云百炼 z-image-turbo） ──────────────────────────
# 用途：阿里云文生图（Z-image）
IMAGE_API_KEY=your_dashscope_api_key_here
IMAGE_MODEL=z-image-turbo

# ── GPT-Image-2 文生图（apimart.ai） ─────────────────────────────
# 用途：GPT-Image 文生图（gpt-img）
GPT_IMAGE_API_KEY=your_gpt_image_api_key_here
GPT_IMAGE_BASE_URL=https://api.apimart.ai/v1
GPT_IMAGE_MODEL=gpt-image-2-official

# ── 代理配置 ─────────────────────────────────────────────────────
# 用途：gpt-img 在 WSL 下自动启用代理；Windows 下仅配置后启用
# IP 自动检测：WSL → Windows 宿主 IP / Windows → 127.0.0.1
# 端口默认 7897，未配置则 WSL 下用 :7897
GPT_IMG_PROXY=http://localhost:7897

# ── Bilibili 下载 ──────────────────────────────────────────────
# 用途：B站视频下载（bili/bilimusic）—— 需要登录的视频需提供 cookies
# 使用浏览器扩展 "Get cookies.txt LOCALLY" 在登录 Bilibili 后导出
# YT_DLP_COOKIES=./cookies.txt

# ── GitHub API（news 热门项目排行） ────────────────────────────
# 用途：news 的 AI 开源项目板块获取 Trending 排名
# 未设置时使用未认证请求（60次/小时，通常够用）
# GITHUB_TOKEN=your_github_token

# ── 默认输出路径 ──────────────────────────────────────────────
# 用途：bili 默认输出目录（未指定 -o 时使用）
BILI_FOLDER=/path/to/bili_output
# 用途：news 默认输出目录（未指定 -o 时使用）
NEWS_FOLDER=/path/to/news_output
# 用途：music 默认输出目录（未指定 -o 时使用）
MUSIC_FOLDER=/path/to/music_output

# ── ComfyUI 本地部署 ────────────────────────────────────────────
# 用途：comfyui --start 进程管理（需指向包含 python.exe 和 main.py 的目录）
COMFYUI_ROOT=/path/to/ComfyUI
