# OPC 环境变量模板
#
# 使用：
#   cp .env.example .env
#   编辑 .env，填写实际的 API Key、Token 和本地路径。
#
# 说明：
# - 未使用的配置项请保持为空或注释，不要填写示例占位符。
# - OPC 只根据变量是否非空判断“已配置”，不会把占位符识别为无效凭证。
# - `opc check-api` 会显示配置使用的变量名，但不会输出密钥内容。
# - 下方变量按当前代码实际读取的配置整理。


# ═══════════════════════════════════════════════════════════════════════
# 一、AI 服务商凭证
# ═══════════════════════════════════════════════════════════════════════

# ── DeepSeek：通用 LLM ────────────────────────────────────────────────
# 主要用于：opc media download --summarize、opc news。
# 也用于 speech asr --llm-fix、image generate --engine gpt-image 提示词增强等通用 LLM 功能。
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash


# ── 智谱：GLM-TTS 与视觉模型 ─────────────────────────────────────────
# 用于：opc speech tts --engine glm-tts、音色列表/克隆、opc image understand。
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Vision 复用 ZHIPU_API_KEY；以下两项只覆盖视觉模型的地址和模型名。
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-5v-turbo


# ── 阿里云 DashScope：统一凭证 ───────────────────────────────────────
# 同一个 ALIYUN_API_KEY 用于：
#   opc speech tts（默认 Qwen/CosyVoice 引擎）
#   opc speech asr
#   opc image generate
#   opc music understand（Qwen3-Omni 音乐理解）
#   opc video understand（Qwen3-VL 视频理解）
#   opc music generate（Fun-Music 音乐生成）
#   opc media download --summarize（ASR 转写）
ALIYUN_API_KEY=

# ASR：opc speech asr、opc media download --summarize
ASR_MODEL=fun-asr-realtime

# Qwen TTS：opc speech tts 默认引擎
QWEN_TTS_MODEL=cosyvoice-v3-flash

# Qwen Image 3.0：opc image generate（文生图或图像编辑）
IMAGE_MODEL=qwen-image-3.0

# 音乐理解：opc music understand
AUDIO_MODEL=qwen3-omni-30b-a3b-captioner

# 视频理解：opc video understand（Qwen3-VL，使用 OpenAI 兼容接口）
VIDEO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_MODEL=qwen3-vl-235b-a22b-instruct

# 音乐生成：opc music generate
# 默认使用阿里云；可设置 MUSIC_GEN_PROVIDER=minimax 切换到 MiniMax。
# 阿里云模型服务仅在华北2（北京）地域可用，且需要先申请邀测权限。
MUSIC_GEN_PROVIDER=aliyun
MUSIC_GEN_MODEL=fun-music-v1
# 推荐填写业务空间 ID，CLI 会自动使用北京地域端点：
# MUSIC_GEN_WORKSPACE_ID=your_workspace_id
# 也可以直接覆盖完整 API 根地址（优先级高于 MUSIC_GEN_WORKSPACE_ID）：
# MUSIC_GEN_BASE_URL=https://your_workspace_id.cn-beijing.maas.aliyuncs.com/api/v1

# MiniMax Music：使用 --provider minimax，默认模型 music-3.0-free（3 RPM）
MINIMAX_API_KEY=
MINIMAX_MUSIC_MODEL=music-3.0-free
# 中国区默认地址；国际区可改为 https://api.minimax.io
MINIMAX_MUSIC_BASE_URL=https://api.minimaxi.com


# ── GPT-Image ─────────────────────────────────────────────────────────
# GPT_IMAGE_API_KEY 仅用于 opc image generate --engine gpt-image；不复用 ALIYUN_API_KEY。
GPT_IMAGE_API_KEY=
GPT_IMAGE_BASE_URL=https://api.apimart.ai/v1
GPT_IMAGE_MODEL=gpt-image-2-official


# ═══════════════════════════════════════════════════════════════════════
# 二、网络代理
# ═══════════════════════════════════════════════════════════════════════

# gpt-img 专用代理。WSL 下会根据该配置的端口连接 Windows 宿主机；
# 不需要代理时保持为空或注释。
# GPT_IMG_PROXY=http://127.0.0.1:7897

# 通用代理：requests/httpx 等依赖会自动读取这些变量。
# 通常建议在启动终端中配置，而不是写入项目 .env。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# 使用 SOCKS 代理时，当前虚拟环境需要安装 socksio：
#   .venv/bin/python -m pip install socksio


# ═══════════════════════════════════════════════════════════════════════
# 三、TTS 音色与本地模型
# ═══════════════════════════════════════════════════════════════════════

# 云端复刻/设计音色 ID，供 tts-serve 的音色列表使用。
# 必须从 VOICE_ID1 开始连续配置；遇到第一个空值后停止，最多读取到 VOICE_ID9。
# 支持在值后添加显示名称，例如：VOICE_ID1=cosyvoice-xxx # 我的音色
# VOICE_ID1=
# VOICE_ID2=
# VOICE_ID3=
# VOICE_ID4=
# VOICE_ID5=
# VOICE_ID6=
# VOICE_ID7=
# VOICE_ID8=
# VOICE_ID9=

# 本地 Qwen3-TTS 模型目录。
# 未配置时会自动探测项目 models/ 目录及 Windows/WSL 默认目录。
# TTS_MODELS_DIR=/path/to/OPC/models


# ═══════════════════════════════════════════════════════════════════════
# 四、下载、日报与输出目录
# ═══════════════════════════════════════════════════════════════════════

# B站、抖音和 X 下载使用的 yt-dlp cookies 文件。
# YT_DLP_COOKIES=./auth/cookies.txt

# news 获取 GitHub AI 项目排行；未配置时使用未认证请求。
# GITHUB_TOKEN=

# 未通过命令行 -o/--output 指定时使用；留空则由命令使用 ./output。
# BILI_FOLDER=./output/bili
# DOUYIN_FOLDER=./output/douyin
# X_FOLDER=./output/x
# MUSIC_FOLDER=./output/music
# NEWS_FOLDER=./output/news


# ═══════════════════════════════════════════════════════════════════════
# 五、本地 ComfyUI
# ═══════════════════════════════════════════════════════════════════════

# 用于 opc comfyui --start，以及定位本地 ComfyUI 的 input 目录。
# COMFYUI_ROOT=/path/to/ComfyUI


# ═══════════════════════════════════════════════════════════════════════
# 六、云扉 AIGate
# ═══════════════════════════════════════════════════════════════════════

# 用于 opc aigate --status/--start/--run；可填写纯 Token 或 Bearer Token。
# AIGATE_TOKEN=

# 仅用于 opc aigate --start --create；创建实例可能产生费用。
# 请先确认 GPU、区域和镜像信息，不要填写他人账户的资源 ID。
# AIGATE_SKU_NAME=
# AIGATE_AREA_NAME=
# AIGATE_IMAGE_ID=
# AIGATE_IMAGE_TYPE=2


# ═══════════════════════════════════════════════════════════════════════
# 七、运行时变量
# ═══════════════════════════════════════════════════════════════════════

# opc 启动时会自动设置 PYTHONIOENCODING=utf-8，通常无需手动配置。
# PYTHONIOENCODING=utf-8

# tts-serve 和本地 comfyui 使用 TEMP 保存 PID/状态文件。
# 未配置时回退到系统临时目录（通常为 /tmp）。
# TEMP=/tmp
